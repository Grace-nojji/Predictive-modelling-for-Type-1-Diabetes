my_metrics <- function(model) {
observed  <- model.response(model.frame(model))
predicted <- fitted(model)
rmse <- sqrt(mean((observed - predicted)^2))
r2   <- cor(observed, predicted)^2
c(RMSE = rmse, R2 = r2)   # named vector = both metrics in one FUN
}
set.seed(123)
boo_both <- bootMer(rirs_step, my_metrics, nsim = 200, use.u = FALSE, type = "parametric")
boo_both
confint(boo_both)
r2_vals
rirs_step
metrics <- function(model) {
r2_out <- r2(model)
c(R2 = r2_out$R2_conditional)
}
boo_r2 <- bootMer(rirs_step, FUN = metrics, nsim = 200, use.u = FALSE, type = "parametric")
boo_r2
confint(boo_r2)
