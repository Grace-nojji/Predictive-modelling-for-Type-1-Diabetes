results <- tidy(multiple_logistic_reg, exponentiate = TRUE, conf.int = TRUE) %>%
filter(term != "(Intercept)")
# Map raw names to presentable labels
label_map <- c(
"GAD_v1_z"        = "GAD Titre",
"IA2_bin_v11"     = "IA2 Status",
"Gender_v1Male"   = "Gender (Male)",
"c_peptide_v1_z"  = "C-peptide at visit 1",
"DKA1"            = "DKA"
)
results <- results %>%
mutate(term_clean = recode(term, !!!label_map))
# Forest plot with clean labels
ggplot(results, aes(x = estimate, y = reorder(term_clean, estimate))) +
geom_point(size = 3) +
geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0.2) +
geom_vline(xintercept = 1, linetype = "dashed", color = "red") +
scale_x_log10() +
labs(x = "Odds Ratio (95% CI)", y = NULL,
title = "Forest Plot: Logistic Regression") +
theme_minimal(base_size = 13)
forest = ggplot(results, aes(x = estimate, y = reorder(term_clean, estimate))) +
geom_point(size = 3) +
geom_errorbarh(aes(xmin = conf.low, xmax = conf.high), height = 0.2) +
geom_vline(xintercept = 1, linetype = "dashed", color = "red") +
scale_x_log10() +
labs(x = "Odds Ratio (95% CI)", y = NULL,
title = "Forest Plot: Logistic Regression") +
theme_minimal(base_size = 13)
